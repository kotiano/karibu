# Karibu POS backend — environment template.
# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).
#
#   cp .env.example .env
#
# In production the app refuses to boot with placeholder secrets or missing
# SMTP config (see assert_production_ready in app/core/config.py) — that's
# deliberate: booting half-configured is worse than not booting.

ENV=development                 # development | production | testing

# The restaurant's wall clock. Storage stays UTC; this decides where a DAY
# starts, which is what "sales today" means to an owner. Set it to wherever the
# restaurant actually is — with the default UTC, takings reset at 3am Nairobi
# time and anything sold after midnight landed on the previous day.
TIMEZONE=Africa/Nairobi

# --- Security ---------------------------------------------------------------
# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
JWT_ISSUER=karibu-pos
JWT_AUDIENCE=karibu-pos-api
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
MAX_BODY_BYTES=1000000

# Comma-separated. Must NOT be "*" in production.
# ALLOWED_HOSTS is this API's OWN hostname. CORS_ORIGINS is the WEB app's
# origin(s) — the API host never appears in an Origin header and does not
# belong there. List apex and www both, or whichever you don't redirect fails
# in the browser with a 200 in the server log.
#   ALLOWED_HOSTS=api.example.com
#   CORS_ORIGINS=https://example.com,https://www.example.com
ALLOWED_HOSTS=*
CORS_ORIGINS=*

# --- Database ---------------------------------------------------------------
# Dev default is a local SQLite file. Production: an asyncpg Postgres URL.
DATABASE_URL=sqlite+aiosqlite:///./karibu_dev.db
# DATABASE_URL=postgresql+asyncpg://karibu:password@localhost:5432/karibu_pos
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# --- Email (REQUIRED IN PRODUCTION) -----------------------------------------
# Signup emails a confirmation LINK and login is blocked until it's clicked, so
# if email is broken NOBODY CAN SIGN UP. Leave both transports unconfigured in
# development and the link is printed to the server log instead — which is how
# you test signup locally without a mail provider.
#
# Verify a real send before trusting it:   python send_test_email.py you@example.com
#
# TRANSPORT — smtp | brevo | resend | sendgrid
# Use an HTTPS API provider on hosts that firewall outbound SMTP. Render's
# free tier blocks ports 25/465/587, so smtplib fails ("[Errno 101] Network is
# unreachable", or a timeout) no matter how correct the credentials are; port
# 443 is always open. On a VPS or locally, plain smtp is fine.
EMAIL_PROVIDER=brevo
# Only for brevo/resend/sendgrid. Brevo's free tier is 300 emails/day and lets
# you verify a single Gmail address as a sender without owning a domain.
#
# TWO steps, in this order — the second fails silently-looking (HTTP 400) if
# you skip the first:
#   1. VERIFY THE SENDER. app.brevo.com -> Senders, Domains & Dedicated IPs ->
#      Senders -> Add a sender -> karibupos@gmail.com. Brevo emails that
#      address a confirmation link; click it. The address here must match
#      EMAIL_FROM below exactly.
#   2. CREATE THE KEY. Account menu (top right) -> SMTP & API -> API Keys ->
#      Generate a new API key. Starts with "xkeysib-". Shown ONCE — copy it
#      now; if you lose it, delete the key and generate another.
# Do NOT use the "SMTP key" from the SMTP tab: that's an SMTP password, and the
# HTTPS API rejects it with 401.
EMAIL_API_KEY=
#
# The SMTP_* block below is only read when EMAIL_PROVIDER=smtp.
#
# SMTP_PASSWORD must be a Gmail APP PASSWORD, never the account password:
#   1. Enable 2-Step Verification on karibupos@gmail.com
#   2. myaccount.google.com → Security → App passwords → generate
#   3. Paste the 16 characters (spaces optional)
# Gmail's free tier allows roughly 500 recipients/day — plenty for signup
# links, but move to Brevo/Mailgun/SendGrid if you outgrow it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=karibupos@gmail.com
SMTP_PASSWORD=
# true = STARTTLS (port 587 or 2525). false = implicit SSL (use port 465).
SMTP_USE_TLS=true
# Gmail rewrites From to the authenticated mailbox, so this MUST match
# SMTP_USER (or an alias verified on it under Accounts → "Send mail as").
EMAIL_FROM=Karibu POS <karibupos@gmail.com>
#
# Switching provider later? Only these change — the app is provider-agnostic:
#   Zoho   : SMTP_HOST=smtp.zoho.com          SMTP_PORT=587
#   Brevo  : SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587 or 2525
#   Mailgun: SMTP_HOST=smtp.mailgun.org       SMTP_PORT=587 or 2525
# Port 2525 is the fallback when a host blocks 587 outbound.
# Worst case (retries+1)*timeout must stay under Gunicorn's 60s --timeout:
# the signup email is sent inline in the request.
SMTP_TIMEOUT_SECONDS=10
EMAIL_SEND_RETRIES=1


PUBLIC_API_URL=http://localhost:8000  # prod: https://<your-api-host>
# Base URL of the WEB APP (Vercel in production). Email confirmation links point
# here, not at the API — the user must land on a page that can sign them in, not
# on a JSON response. A wrong value produces links that 404 and blocks every new
# signup, so check it after any redeploy to a new domain.
PUBLIC_WEB_URL=http://localhost:3000

# --- Subscription / billing -------------------------------------------------
SUBSCRIPTION_PRICE_CENTS=49900
SUBSCRIPTION_CURRENCY=KES
TRIAL_DAYS=14
BILLING_PERIOD_DAYS=30
DUNNING_RETRY_HOURS=0,24,72,120
CHARGE_STALE_MINUTES=10

# --- Paystack (M-Pesa collection) -------------------------------------------
# Subscriptions are collected by pushing an M-Pesa STK prompt through Paystack
# instead of Safaricom's Daraja API. Daraja production access needs a
# registered company with its own paybill/till; Paystack onboards unregistered
# "Starter" merchants (personal bank/mobile-money payout, ID + proof of
# address, subject to a lifetime collection cap until you upgrade).
#
# Get the keys: dashboard.paystack.com -> Settings -> API Keys & Webhooks.
#   sk_test_... exercises the full flow without moving money
#   sk_live_... is live; only shown once, rotate it if it ever leaks
# Leave empty in development and charges are simulated (no network call).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
#
# Set the webhook URL on that same Paystack settings page to:
#   https://<your-api-host>/api/billing/webhook/paystack
# Webhooks are authenticated by an HMAC-SHA512 signature over the request body
# keyed with PAYSTACK_SECRET_KEY, so there is no secret in the URL to leak.
#
# Optional belt-and-braces IP allowlist. Leave EMPTY unless you have a reason:
# if Paystack changes these addresses, a stale list 403s every real webhook and
# subscriptions silently stop confirming.
#   52.31.139.75,52.49.173.169,52.214.14.220
PAYSTACK_WEBHOOK_ALLOWED_IPS=

# --- Rate limiting / cache --------------------------------------------------
# Use Redis when running more than one instance, or limits are per-process.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200/minute
RATELIMIT_LOGIN=5/minute
CACHE_URL=
CACHE_MENU_TTL_SECONDS=60

# --- Infra ------------------------------------------------------------------
FORCE_HTTPS=false
# With >1 instance, set true on exactly ONE or the billing sweep double-fires.
ENABLE_SCHEDULER=true

